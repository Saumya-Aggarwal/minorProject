# Copy to backend/.env and fill in. Never commit .env.

# --- WhatsApp Cloud API ---
# Temporary token from App Dashboard > WhatsApp > API Setup (expires in ~24h)
WHATSAPP_ACCESS_TOKEN=your-access-token-here

# Any string YOU make up. Paste the same value into the Meta dashboard "Verify token" field.
WHATSAPP_VERIFY_TOKEN=your-verify-token-here

# From App Dashboard > WhatsApp > API Setup ("Phone number ID", not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# The test number itself, digits only, no '+'. Used to build wa.me deep links
# for account linking. This is the number shown as "From" in the dashboard.
WHATSAPP_DISPLAY_NUMBER=15550000000

# --- Website session cookie ---
# Any long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM replies ---
# OpenAI-compatible Groq endpoint for the bot introduction. The numbered
# product list is always generated by the application, not by the LLM.
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# --- OpenAI embeddings / legacy LLM fallback ---
# Required only when EMBEDDING_PROVIDER=openai, or when using the legacy
# OPENAI_CHAT_MODEL fallback in bot/chat.py.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- ChromaDB (docker-compose maps container 8000 -> host 8001) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp_dev_password
POSTGRES_DB=whatsapp
DATABASE_URL=postgresql://whatsapp:whatsapp_dev_password@localhost:5432/whatsapp

# --- Embeddings ---
# local (default) = all-MiniLM-L6-v2 on CPU, no API key, 384 dims
# openai = text-embedding-3-small, needs OPENAI_API_KEY, 1536 dims
# Changing this requires re-running scripts/ingest_catalog.py
EMBEDDING_PROVIDER=local

# --- Public URL (A6) ---
# ngrok free static domain, so links and the Meta webhook survive restarts.
# Used for product links in chat (B7) and Razorpay callbacks (A3).
PUBLIC_BASE_URL=https://your-name.ngrok-free.app

# --- Razorpay (A3), test mode ---
# Dashboard (Test Mode) -> Account & Settings -> API Keys. Test keys start rzp_test_.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard -> Webhooks -> Add New Webhook. URL: <PUBLIC_BASE_URL>/razorpay/webhook
# Events: payment_link.paid (required), payment.failed (logged).
# You choose this secret when creating the webhook; Razorpay signs with it.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

