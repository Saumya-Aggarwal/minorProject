# Copy to backend/.env and fill in. Never commit .env.

# --- WhatsApp Cloud API ---
# Temporary token from App Dashboard > WhatsApp > API Setup (expires in ~24h)
WHATSAPP_ACCESS_TOKEN=your-access-token-here

# Any string YOU make up. Paste the same value into the Meta dashboard "Verify token" field.
WHATSAPP_VERIFY_TOKEN=your-verify-token-here

# From App Dashboard > WhatsApp > API Setup ("Phone number ID", not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# --- OpenAI ---
# Required by scripts/ingest_catalog.py and bot/chat.py
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- ChromaDB (docker-compose maps container 8000 -> host 8001) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp_dev_password
POSTGRES_DB=whatsapp
DATABASE_URL=postgresql://whatsapp:whatsapp_dev_password@localhost:5432/whatsapp
